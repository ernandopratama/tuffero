APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuffero
DB_USERNAME=tuffero
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Opsional: metode di jendela bayar (kode Snap dipisah koma). Kosong = QRIS, virtual account, dan kartu (bawaan di config/services.php).
# Isi `all` untuk semua metode yang aktif di dashboard Midtrans.
MIDTRANS_ENABLED_PAYMENTS=

BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
# Kode pos gudang asal, 5 digit. Ongkir Biteship aktif hanya bila kunci dan kode pos ini terisi.
BITESHIP_ORIGIN_POSTAL_CODE=
# Opsional: batas panggilan pelacakan paket per hari untuk seluruh toko (0 = tanpa batas).
BITESHIP_DAILY_TRACKING_LIMIT=500
BITESHIP_WEBHOOK_SECRET=
# Batas cek tarif Biteship per hari (tiap cek 5 pts). 0 = tanpa batas.
BITESHIP_DAILY_RATE_LIMIT=200

# Claude API (D-061). Isi kunci hanya di .env server; satu kunci per lingkungan. Model terkecil dan termurah per tugas;
# ganti ke claude-sonnet-5-5 bila mutu kurang. Cek dengan: php artisan ai:check
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANGUAGE=id
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_OTP_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TRANSLATION=claude-haiku-5-5
ANTHROPIC_MODEL_PRODUCT_INTAKE=claude-haiku-5-5
ANTHROPIC_MODEL_CHAT=claude-haiku-5-5
CHAT_AI_ENABLED=true
ANTHROPIC_MODEL_MARKETING=claude-sonnet-5-5
MARKETING_AI_ENABLED=true
# Token penerima laporan riset Hermes (min. 32 karakter; kosong = mati). Samakan dengan TUFFERO_INGEST_TOKEN di .env Hermes.
HERMES_INGEST_TOKEN=
# Hanya bila kunci tidak terikat satu workspace:
ANTHROPIC_WORKSPACE_ID=

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
